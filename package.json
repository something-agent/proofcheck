{
  "name": "proofcheck",
  "version": "0.1.2",
  "description": "Free verifier for x402 signed offers and receipts, with signer-authorization evidence (payTo, did:web, DNS, ERC-8004). HTTP API + remote MCP server on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc -p .",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --outdir dist"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/node": "^22.20.5",
    "@x402/extensions": "^2.28.0",
    "typescript": "^5.9.3",
    "viem": "^2.38.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.86.0"
  }
}
